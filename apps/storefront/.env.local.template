# Publishable API key from Medusa Admin → Settings → Publishable API Keys
# (Created automatically on first `npx medusa db:migrate` via initial-data-seed)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_key_here

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region: ca (Canada/CAD) or us (United States/USD)
NEXT_PUBLIC_DEFAULT_REGION=ca

# Base URL of the storefront (used for generating absolute URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe publishable key (optional)
NEXT_PUBLIC_STRIPE_KEY=

# --- Supabase (future: Storage / Auth — not used by storefront yet) ---
# Project URL from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — safe for client-side use when Storage/Auth is added
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key — SERVER ONLY. Never expose to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SERVER ONLY — same Supabase URI as backend; storefront auto-uses port 6543 (transaction pooler).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

NODE_ENV=development
